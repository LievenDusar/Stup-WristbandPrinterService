{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stup",
      "runtimeExecutable": "./mvnw",
      "runtimeArgs": ["spring-boot:run", "-Dspring-boot.run.profiles=local"],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "stup8081",
      "runtimeExecutable": "./mvnw",
      "runtimeArgs": ["spring-boot:run", "-Dspring-boot.run.profiles=local", "-Dspring-boot.run.arguments=--server.port=8081"],
      "port": 8081,
      "autoPort": false
    }
  ]
}
