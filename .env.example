# Copy to .env.prod (production) and fill in real values.
# Local development needs nothing here — docker-compose.yml and
# docker-compose.local-cluster.yml set their own credentials/keys.

# --- Production stack (docker-compose.prod.yml) ---

# Shared API key. Management uses it to call the workers; every worker validates it.
# Both MUST be the same value.
API_KEY=your-strong-api-key-here

# Admin password for the management jobs/login UI.
ADMIN_PASSWORD=your-strong-admin-password

# Password protecting the management HTTPS keystore (auto-generated on first start).
SSL_KEYSTORE_PASSWORD=your-strong-keystore-password

# Hostname Symfony uses to reach the management service; becomes the TLS cert CN/SAN.
MANAGEMENT_HOSTNAME=wristbands.example.local

# Remote dedicated `wristbands` database on the Symfony Postgres instance.
# The DBA must create this empty database + role beforehand.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.example.internal:5432/wristbands
DB_USERNAME=wristbands
DB_PASSWORD=your-strong-db-password

# One PRINTERn_HOST per physical printer = the Zebra's IP/host, reachable from the server.
# Each value is consumed by the matching printer-worker-N service.
PRINTER1_HOST=192.168.1.50
# PRINTER2_HOST=192.168.1.51
